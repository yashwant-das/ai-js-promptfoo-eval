{
  "name": "promptfoo-eval",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Evaluates LLM output with promptfoo and local models: translation quality and test cases written from user stories",
  "private": true,
  "scripts": {
    "eval": "promptfoo eval",
    "eval:full": "promptfoo eval -c promptfooconfig.full.yaml",
    "eval:test-design": "promptfoo eval -c promptfooconfig.test-design.yaml",
    "eval:watch": "promptfoo eval -w",
    "test": "node --test \"tests/test-design/*.test.js\" \"scripts/*.test.js\"",
    "publish": "promptfoo publish",
    "report": "promptfoo view",
    "compare": "node scripts/compare.js",
    "baseline": "node scripts/baseline.js",
    "lint:js": "eslint .",
    "format:check": "prettier --check \"**/*.{js,json,jsonc}\"",
    "lint:md": "markdownlint-cli2 \"*.md\" \"docs/**/*.md\"",
    "lint": "npm run lint:js && npm run format:check && npm run lint:md"
  },
  "keywords": [
    "promptfoo",
    "llm",
    "evaluation",
    "testing",
    "translation",
    "ai",
    "test-design",
    "user-stories"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "homepage": "https://github.com/yashwant-das/ai-js-promptfoo-eval",
  "bugs": {
    "url": "https://github.com/yashwant-das/ai-js-promptfoo-eval/issues"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "js-yaml": "5.5.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "3.9.10",
    "promptfoo": "0.125.1"
  },
  "overrides": {
    "markdownlint": {
      "re2js": "2.8.7"
    }
  }
}
