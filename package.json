{
  "name": "promptfoo-eval",
  "version": "1.0.0",
  "description": "Evaluates LLM output with promptfoo and local models: translation quality and test cases written from user stories",
  "private": true,
  "scripts": {
    "eval": "promptfoo eval",
    "eval:full": "promptfoo eval -c promptfooconfig.full.yaml",
    "eval:test-design": "promptfoo eval -c promptfooconfig.test-design.yaml",
    "eval:watch": "promptfoo eval -w",
    "test": "node --test \"tests/test-design/*.test.js\"",
    "publish": "promptfoo publish",
    "report": "promptfoo view",
    "compare": "promptfoo eval --diff"
  },
  "keywords": [
    "promptfoo",
    "llm",
    "evaluation",
    "testing",
    "translation",
    "ai",
    "test-design",
    "user-stories"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "homepage": "https://github.com/yashwant-das/ai-js-promptfoo-eval",
  "bugs": {
    "url": "https://github.com/yashwant-das/ai-js-promptfoo-eval/issues"
  },
  "devDependencies": {
    "promptfoo": "^0.123.1"
  }
}
